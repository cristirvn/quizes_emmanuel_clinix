# Emmanuel CliniX — environment variables
# Copy to `.env.local` and fill with real values (client-provided).

# GoHighLevel inbound webhook — the lead form POSTs here server-side.
GHL_WEBHOOK_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Ads global tag / conversion ID (e.g. AW-XXXXXXXXXX)
NEXT_PUBLIC_GADS_ID=

# Google Ads conversion label for the /multumim lead event (e.g. AbCdEfGh123)
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# Microsoft Clarity project ID — session recordings + heatmaps for quiz drop-off.
NEXT_PUBLIC_CLARITY_ID=

# Public site origin used for canonical URLs / sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://emmanuelclinix.ro

# GoHighLevel Calendar embed URL for /lp/emsella (Calendars → pick calendar
# → Share → Embed Code → copy the iframe `src`, looks like
# https://api.leadconnectorhq.com/widget/booking/<calendarId>).
NEXT_PUBLIC_GHL_BOOKING_URL=
